 "params": {
  "Flow-head clone N": "3 packets per new flow; read back {1: 3, 2: 3} in every run (table above)",
  "Adaptive sampling": "NORMAL 1-in-64, MONITOR 1-in-8 (of the slot's packet counter), CLONE/DROP every packet",
  "Hysteresis": "escalate after K_UP = 2 consecutive windows above the current level; de-escalate after K_DOWN = 3 below; DPI confirmations bypass it",
  "DPI confirmation action": "DROP: the flow's 5-tuple drop rule, plus a source-IP drop rule for syn/null scans (a dropped packet is still cloned to DPI)",
  "Drop rule removal": "after K_DOWN = 3 scored windows below DROP (the IF never sets DROP, so a forced DROP dwells 3 scored windows unless confirmed again), or when the flow's slot ages out (3 idle polls), whichever comes first; a source drop after its host pair's K_DOWN windows",
  "DPI syn-scan rule": "SYN-only share > 0.9 AND >= 5 distinct dst ports over the host pair's cloned TCP packets of the last 3.0 s",
  "DPI other rules": "null_scan: TCP flags == 0; sqli: 4 regexes on HTTP payload (OR 1=1, UNION SELECT, --, /*)",
  "DPI confirmation retry": "a confirmation for a flow not active this poll is retried for 10 polls",
  "IsolationForest": "n_estimators = 100, max_samples = 256, contamination = 0.05, random_state = 42; log1p on flow pkt_count, byte_count, duration_s, pkt_rate and on pair new_flows, distinct_dst_ports, pkt_count; >= 50 warm-up samples to train",
  "IF features": "flow: pkt_count, byte_count, duration_s, pkt_rate, mean_pkt_size, entropy (payload byte entropy of the flow's DPI clones when any, else flow-distribution entropy -- Decision C); host pair: new_flows, distinct_dst_ports, syn_only_ratio, pkt_count (per poll window)",
  "Poll interval": "1.0 s configured; measured mean 1.002 s, P95 1.086 s over scored polls",
  "Slot aging": "a slot unchanged for 3 polls is cleared",
  "Warm-up": "30 s benign-only before the one-time training (controller start-up 4 s before that); 33\u201334 warm-up polls per run",
  "Cycles / phase gap": "8 cycles per run; 1.5 s between phases",
  "Benign: iperf3 TCP h1\u2192h3": "seeded per cycle, 1.03\u20132.92 Mbit/s (warm-up 1.18\u20131.97); measured 89 pkt/s median per flow on s1; benign phase 6.09\u20139.88 s",
  "Benign: HTTP POST h2\u2192h4:8000": "one request per new TCP connection, every 1.0 s \u00b1 30% (warm-up every 1.5 s \u00b1 30%), random benign body",
  "Attack: nmap -sS / -sN h1\u2192h3": "8 ports per scan (seeded, 1\u20131023), --max-rate 500 pkt/s, 1 probe per port per flow (median 1 / 1 packets per flow)",
  "Attack: SQLi POST h2\u2192h4:8000": "4 requests, 0.1 s apart, one per SQLi pattern, seeded order (median 5 packets per flow)",
  "Attack: UDP rate spike h2\u2192h4:9999": "1000 pkt/s for 5 s, 64-byte payload; measured 985 pkt/s median on s1"
